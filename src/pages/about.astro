---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="About | Moonbloom Farm"
  description="Meet Brittney Harvey and John Singleton, the family behind Moonbloom Farm — a small farm and roadside stand in Glen Ellen, growing eggs and produce in the Sonoma Valley since 2023."
>
  <PageHero
    title="About Moonbloom"
    subtitle="A small Sonoma Valley farm and roadside stand, run by two people in their first chapter of doing this."
  />

  <!-- Story Section -->
  <section class="story-section" aria-label="Our Story">
    <div class="container">
      <!-- Block 1: Photo left, text right -->
      <div class="story-block">
        <div class="story-photo-wrapper">
          <div class="story-photo-placeholder">
            <img src="/images/about-farm.svg" alt="Moonbloom Farm fields" class="story-photo-img" loading="lazy" />
          </div>
        </div>
        <div class="story-text">
          <h2 class="story-heading">How It All Began</h2>
          <p class="story-description">
            Moonbloom started in 2023, when we set down roots on a stretch of Sonoma Valley land and got to work. What began as a backyard project — a few rows of vegetables, a small flock of chickens — has slowly grown into the roadside stand you'll find on Arnold Drive today.
          </p>
          <p class="story-description">
            We're still figuring it out, season by season. The land teaches us. Some weeks we have more eggs than we know what to do with; some weeks the garden runs wild. We bring what we have to the stand and try to leave it a little better than we found it.
          </p>
        </div>
      </div>

      <!-- Block 2: Text left, photo right -->
      <div class="story-block story-block--reversed">
        <div class="story-photo-wrapper">
          <div class="story-photo-placeholder">
            <img src="/images/placeholder-flowers.svg" alt="Growing philosophy at Moonbloom Farm" class="story-photo-img" loading="lazy" />
          </div>
        </div>
        <div class="story-text">
          <h2 class="story-heading">Our Growing Philosophy</h2>
          <p class="story-description">
            We grow without synthetic pesticides or herbicides — just compost, cover crops, and a willingness to let the seasons set the pace. The chickens get the run of the place. The garden gets time.
          </p>
          <p class="story-description">
            What ends up at the stand is whatever the land decided to give us that week. We think it tastes better that way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values / Philosophy Section -->
  <section class="values-section" aria-label="Our Values">
    <div class="container">
      <h2 class="values-heading">What We Stand For</h2>
      <div class="values-grid">
        <!-- Sustainably Grown -->
        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 44C24 44 8 34 8 20C8 12 14 6 22 6C24 6 24 8 24 8C24 8 24 6 26 6C34 6 40 12 40 20C40 34 24 44 24 44Z" stroke="currentColor" stroke-width="2" fill="none" />
              <path d="M24 44V18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M24 28C24 28 18 24 16 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" />
              <path d="M24 22C24 22 30 18 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" />
            </svg>
          </div>
          <h3 class="value-title">Sustainably Grown</h3>
          <p class="value-description">
            No synthetic chemicals, no shortcuts. We feed the soil with compost and cover crops and let it do its work, season by season.
          </p>
        </div>

        <!-- Locally Rooted -->
        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 4C16.268 4 10 10.268 10 18C10 28 24 44 24 44C24 44 38 28 38 18C38 10.268 31.732 4 24 4Z" stroke="currentColor" stroke-width="2" fill="none" />
              <circle cx="24" cy="18" r="6" stroke="currentColor" stroke-width="2" fill="none" />
              <path d="M24 15V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M21 18H27" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="value-title">Locally Rooted</h3>
          <p class="value-description">
            Everything we grow stays in the valley. The stand sits at the edge of our driveway in Glen Ellen — close enough that the eggs are usually still warm.
          </p>
        </div>

        <!-- Seasonally Inspired -->
        <div class="value-card">
          <div class="value-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2" fill="none" />
              <line x1="24" y1="4" x2="24" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="24" y1="36" x2="24" y2="44" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="4" y1="24" x2="12" y2="24" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="36" y1="24" x2="44" y2="24" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="9.86" y1="9.86" x2="15.52" y2="15.52" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="32.48" y1="32.48" x2="38.14" y2="38.14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="9.86" y1="38.14" x2="15.52" y2="32.48" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="32.48" y1="15.52" x2="38.14" y2="9.86" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="value-title">Seasonally Inspired</h3>
          <p class="value-description">
            We follow the calendar that nature writes. Spring greens, summer tomatoes, fall squash — what's at the stand is whatever the season is offering, and we wouldn't have it any other way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Farmers Section -->
  <section class="farmer-section" aria-label="Meet the Farmers">
    <div class="container">
      <div class="farmer-block">
        <div class="farmer-photo-wrapper">
          <div class="farmer-photo-placeholder">
            <img src="/images/about-farmer.svg" alt="Brittney Harvey and John Singleton at Moonbloom Farm" class="farmer-photo-img" loading="lazy" />
          </div>
        </div>
        <div class="farmer-text">
          <h2 class="farmer-heading">Meet the Farmers</h2>
          <p class="farmer-name">Brittney Harvey &amp; John Singleton</p>
          <p class="farmer-bio">
            Brittney and John traded a busier life for a quieter one in 2023, swapping the city for a few acres in Glen Ellen and a steady rotation of small projects with feathers, leaves, and dirt.
          </p>
          <p class="farmer-bio">
            Moonbloom is a side-of-the-road, side-of-life kind of farm — not their day job, but where real care goes. Stop by the stand on a Friday morning and one of them will probably be there to say hello.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Story Section ─── */
  .story-section {
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  .story-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-2xl);
  }

  .story-block:last-child {
    margin-bottom: 0;
  }

  .story-block--reversed {
    direction: rtl;
  }

  .story-block--reversed > * {
    direction: ltr;
  }

  .story-photo-wrapper {
    display: flex;
    justify-content: center;
  }

  .story-photo-placeholder {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 5;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 24px rgba(110, 92, 74, 0.10);
    overflow: hidden;
  }

  .story-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-3xl));
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .story-description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-sm);
  }

  .story-description:last-child {
    margin-bottom: 0;
  }

  /* ─── Values Section ─── */
  .values-section {
    background-color: var(--color-paper-deep);
    padding: var(--space-2xl) 0;
  }

  .values-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-3xl));
    font-weight: 700;
    color: var(--color-ink);
    text-align: center;
    margin: 0 0 var(--space-xl);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .value-card {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
  }

  .value-icon {
    color: var(--color-moss);
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }

  .value-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
  }

  .value-description {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ─── Meet the Farmer Section ─── */
  .farmer-section {
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  .farmer-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .farmer-photo-wrapper {
    display: flex;
    justify-content: center;
  }

  .farmer-photo-placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    box-shadow: 0 4px 24px rgba(110, 92, 74, 0.10);
    overflow: hidden;
  }

  .farmer-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .farmer-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-3xl));
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs);
  }

  .farmer-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-clay);
    margin: 0 0 var(--space-md);
    font-style: italic;
  }

  .farmer-bio {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-sm);
  }

  .farmer-bio:last-child {
    margin-bottom: 0;
  }

  /* ─── Responsive: Tablet ─── */
  @media (max-width: 768px) {
    .story-block,
    .story-block--reversed {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      text-align: center;
      direction: ltr;
    }

    .story-photo-placeholder {
      max-width: 320px;
    }

    .values-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .farmer-block {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      text-align: center;
    }

    .farmer-photo-placeholder {
      max-width: 280px;
    }
  }

  /* ─── Responsive: Small Mobile ─── */
  @media (max-width: 480px) {
    .story-section,
    .farmer-section {
      padding: var(--space-sm) 0 var(--space-xl);
    }

    .values-section {
      padding: var(--space-xl) 0;
    }

    .story-block {
      margin-bottom: var(--space-xl);
    }
  }
</style>
