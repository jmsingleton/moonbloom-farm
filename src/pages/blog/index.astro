---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Blog | Moonbloom Farm"
  description="Stories from the field — seasonal updates, growing tips, and farm life at Moonbloom Farm in the Sonoma Valley."
>
  <PageHero
    title="From the Field"
    subtitle="Seasonal stories, growing updates, and dispatches from life on the farm."
  />

  <!-- Blog Post Listing -->
  <section class="blog-listing" aria-label="Blog Posts">
    <div class="container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <p class="blog-empty-message">
            Stories will arrive when the season picks up.
          </p>
          <p class="blog-empty-followup">
            Until then, come find us at the stand on Arnold Drive — Friday through Sunday, when we can.
          </p>
          <a href="/contact" class="blog-empty-link">
            Plan your visit <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <article class="blog-card">
                <div class="blog-card-image" aria-hidden="true"></div>
                <div class="blog-card-body">
                  <time class="blog-card-date" datetime={post.data.date.toISOString()}>
                    {formattedDate}
                  </time>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-excerpt">{post.data.description}</p>
                  <a href={`/blog/${post.id}`} class="blog-card-link">
                    Read More <span class="blog-card-link-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Blog Listing Section ─── */
  .blog-listing {
    padding: var(--space-2xl) 0;
  }

  /* ─── Empty State ─── */
  .blog-empty {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .blog-empty-message {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(var(--font-size-xl), 3vw, var(--font-size-2xl));
    line-height: 1.4;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .blog-empty-followup {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-lg);
  }

  .blog-empty-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-moss);
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2em;
    text-decoration: none;
    transition: color var(--transition);
  }

  .blog-empty-link:hover {
    color: var(--color-clay);
  }

  /* ─── Card Grid ─── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* ─── Card ─── */
  .blog-card {
    background-color: var(--color-paper);
    border-radius: var(--border-radius);
    box-shadow: 0 2px 12px rgba(110, 92, 74, 0.08);
    border: 1px solid rgba(110, 92, 74, 0.08);
    overflow: hidden;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(110, 92, 74, 0.14);
  }

  /* ─── Card Image Placeholder ─── */
  .blog-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-paper-deep);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ─── Card Body ─── */
  .blog-card-body {
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .blog-card-date {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
    opacity: 0.7;
  }

  .blog-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  .blog-card-excerpt {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ─── Read More Link ─── */
  .blog-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-moss);
    text-decoration: none;
    margin-top: var(--space-xs);
    transition: color var(--transition);
  }

  .blog-card-link:hover {
    color: var(--color-clay);
  }

  .blog-card-link-arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .blog-card-link:hover .blog-card-link-arrow {
    transform: translateX(4px);
  }

  /* ─── Responsive: Mobile ─── */
  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .blog-listing {
      padding: var(--space-xl) 0;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-card-link,
    .blog-card-link-arrow {
      transition: none;
    }
  }
</style>
