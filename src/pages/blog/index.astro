---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="journal — moonbloom farm"
  description="Stories from the field — seasonal stories and growing updates from Moonbloom Farm in the Sonoma Valley."
>
  <section class="blog-hero">
    <div class="container">
      <h1>from the field</h1>
      <p class="blog-hero-sub">Seasonal stories, growing updates, and dispatches from life on the farm.</p>
    </div>
  </section>

  <!-- Blog Post Listing -->
  <section class="blog-listing" aria-label="Blog Posts">
    <div class="container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <p class="blog-empty-message">
            Stories will arrive when the season picks up.
          </p>
          <p class="blog-empty-followup">
            Until then, come find us at the stand on Carmel Avenue — Friday through Sunday, when we can.
          </p>
          <a href="/visit" class="link">
            plan your visit →
          </a>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <article class="blog-card">
                <div class="blog-card-body">
                  <time class="blog-card-date" datetime={post.data.date.toISOString()}>
                    {formattedDate}
                  </time>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-excerpt">{post.data.description}</p>
                  <a href={`/blog/${post.id}`} class="link">
                    read more →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Blog Hero ─── */
  .blog-hero {
    padding: var(--space-2xl) 0 var(--space-lg);
  }

  .blog-hero-sub {
    margin-top: var(--space-md);
    font-size: var(--text-lg);
    font-weight: 500;
    max-width: 44ch;
  }

  /* ─── Blog Listing Section ─── */
  .blog-listing {
    padding: var(--space-2xl) 0;
  }

  /* ─── Empty State ─── */
  .blog-empty {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
    padding: var(--space-xl) 0;
  }

  .blog-empty-message {
    font-family: var(--font);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 var(--space-md);
  }

  .blog-empty-followup {
    font-family: var(--font);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--ink);
    margin: 0 0 var(--space-lg);
  }

  /* ─── Card Grid ─── */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* ─── Card ─── */
  .blog-card {
    background: var(--paper);
    border: 3px solid var(--ink);
  }

  /* ─── Card Body ─── */
  .blog-card-body {
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .blog-card-date {
    font-family: var(--font);
    font-size: var(--text-sm);
    color: var(--ink);
    opacity: 0.7;
  }

  .blog-card-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .blog-card-excerpt {
    font-family: var(--font);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ─── Responsive: Mobile ─── */
  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .blog-listing {
      padding: var(--space-xl) 0;
    }
  }
</style>
