---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get all posts sorted by date (newest first) for prev/next navigation
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const currentIndex = allPosts.findIndex((p) => p.id === entry.id);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const formattedDate = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title.toLowerCase()} — moonbloom farm`}
  description={entry.data.description}
>
  <article class="blog-post">
    <!-- Article Header -->
    <header class="post-header">
      <div class="post-header-inner">
        <time class="post-date" datetime={entry.data.date.toISOString()}>
          {formattedDate}
        </time>
        <h1 class="post-title">{entry.data.title}</h1>
      </div>
    </header>

    <!-- Article Body (Markdown Content) -->
    <div class="post-body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <!-- Post Navigation -->
    <nav class="post-nav" aria-label="Post navigation">
      <div class="post-nav-inner">
        <a href="/blog" class="post-nav-back">
          &larr; back to the journal
        </a>

        <div class="post-nav-links">
          {prevPost && (
            <a href={`/blog/${prevPost.id}`} class="post-nav-link post-nav-prev">
              <span class="post-nav-label">Previous</span>
              <span class="post-nav-title">&larr; {prevPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}`} class="post-nav-link post-nav-next">
              <span class="post-nav-label">Next</span>
              <span class="post-nav-title">{nextPost.data.title} &rarr;</span>
            </a>
          )}
        </div>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ─── Article Wrapper ─── */
  .blog-post {
    padding-bottom: var(--space-2xl);
  }

  /* ─── Post Header ─── */
  .post-header {
    padding: var(--space-2xl) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .post-header-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-date {
    display: block;
    font-family: var(--font);
    font-size: var(--text-sm);
    color: var(--ink);
    opacity: 0.7;
    text-transform: lowercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-size: var(--text-display-sm);
    line-height: 1.15;
    margin: 0;
  }

  /* ─── Post Body / Prose ─── */
  .post-body {
    padding: 0 var(--space-md);
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    font-family: var(--font);
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--ink);
  }

  /* Intentional: prose h2 shares --text-display-sm with .post-title above.
     Site-wide h2 is display-sm; the post title is set down to that size too
     (it's distinguished by the centered date eyebrow, not by being larger).
     Don't "fix" the parity by shrinking h2 — it would collide h3/h4. */
  .prose :global(h2) {
    font-size: var(--text-display-sm);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    line-height: 1.2;
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
    line-height: 1.25;
  }

  /* h4–h6 are not covered by the global h1,h2,h3 rule — give them the display voice explicitly */
  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    font-weight: 900;
    font-stretch: 125%;
    text-transform: lowercase;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }

  .prose :global(h4) {
    font-size: var(--text-lg);
  }

  .prose :global(h5) {
    font-size: var(--text-base);
  }

  .prose :global(h6) {
    font-size: var(--text-base);
  }

  .prose :global(p) {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .prose :global(blockquote) {
    margin: var(--space-lg) 0;
    padding: var(--space-sm) var(--space-md);
    border-left: 4px solid var(--ink);
    background: var(--butter);
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: var(--space-sm) 0 var(--space-md);
    padding-left: var(--space-md);
  }

  .prose :global(li) {
    margin-bottom: var(--space-xs);
  }

  .prose :global(ul li) {
    list-style-type: disc;
  }

  .prose :global(ol li) {
    list-style-type: decimal;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--space-lg) 0;
  }

  .prose :global(a) {
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--ink);
    margin: var(--space-lg) 0;
  }

  /* ─── Post Navigation ─── */
  .post-nav {
    padding: var(--space-xl) var(--space-md) 0;
    border-top: 1px solid var(--ink);
    margin-top: var(--space-xl);
  }

  .post-nav-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-nav-back {
    display: block;
    text-align: center;
    font-family: var(--font);
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--ink);
    width: fit-content;
    margin: 0 auto var(--space-lg);
    padding-bottom: 0.1em;
  }

  .post-nav-links {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    border: 3px solid var(--ink);
  }

  .post-nav-prev {
    text-align: left;
  }

  .post-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .post-nav-label {
    font-family: var(--font);
    font-size: var(--text-sm);
    color: var(--ink);
    text-transform: lowercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }

  .post-nav-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .post-header {
      padding: var(--space-xl) var(--space-sm) var(--space-md);
    }

    .post-body {
      padding: 0 var(--space-sm);
    }

    .post-nav {
      padding: var(--space-lg) var(--space-sm) 0;
    }

    .post-nav-links {
      flex-direction: column;
    }

    .post-nav-next {
      text-align: left;
      margin-left: 0;
    }
  }

  @media (max-width: 480px) {
    .post-header {
      padding: var(--space-lg) var(--space-sm) var(--space-sm);
    }

    .prose {
      font-size: var(--text-base);
    }
  }
</style>
