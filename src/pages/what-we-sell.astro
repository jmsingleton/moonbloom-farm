---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const features = [
  {
    id: 'eggs',
    name: 'Eggs',
    tagline: 'Pasture-raised, when the girls are laying.',
    body: 'Our small flock has the run of the place — bugs, weeds, dust baths, the works. The eggs come in bright yolks and whatever colors the hens decide on this season.',
    image: '/images/placeholder-eggs.svg',
  },
  {
    id: 'produce',
    name: 'Produce',
    tagline: 'Whatever the garden is offering this week.',
    body: 'We grow without synthetic chemicals and let the season set the pace. Some weeks that means tomatoes by the basket. Some weeks it means a small bunch of herbs and not much else. We bring what is ready to the stand — and we like that it varies.',
    image: '/images/placeholder-produce.svg',
  },
  {
    id: 'baked-goods',
    name: 'Baked Goods',
    tagline: 'Made in the farmhouse kitchen, when the oven is on.',
    body: "Sourdough loaves, scones, the occasional pie — whatever we felt like making that week, with eggs from our flock and whatever the garden is offering. Quantities are small. If you see something at the stand, it is probably the only one.",
    image: '/images/placeholder-baked-goods.svg',
  },
];
---

<BaseLayout
  title="What We Sell | Moonbloom Farm"
  description="Eggs from our flock, produce from the garden, and baked goods from the farmhouse kitchen — what you'll find at the Moonbloom Farm stand on Arnold Drive in Glen Ellen, California."
>
  <PageHero
    title="What We Sell"
    subtitle="A small offering, honestly described — eggs from our flock, produce from the garden, and whatever just came out of the oven."
  />

  <!-- Feature Blocks -->
  <div class="features">
    {features.map((feature, index) => (
      <section
        class:list={['feature', { 'feature--reversed': index % 2 === 1 }]}
        id={feature.id}
        aria-label={feature.name}
      >
        <div class="container feature-grid">
          <div class="feature-image-wrapper">
            <div class="feature-image">
              <img src={feature.image} alt={feature.name} class="feature-img" loading="lazy" />
            </div>
          </div>
          <div class="feature-text">
            <h2 class="feature-name">{feature.name}</h2>
            <p class="feature-tagline">{feature.tagline}</p>
            <p class="feature-body">{feature.body}</p>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Bottom CTA -->
  <section class="bottom-cta" aria-label="Visit the farm stand">
    <div class="container">
      <p class="bottom-cta-text">Stop by the stand to see what's available today.</p>
      <a href="/contact" class="bottom-cta-link">
        Get Directions <span class="bottom-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Feature Blocks ─── */
  .features {
    padding: var(--space-2xl) 0;
  }

  .feature {
    padding: var(--space-xl) 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .feature--reversed .feature-grid {
    direction: rtl;
  }

  .feature--reversed .feature-grid > * {
    direction: ltr;
  }

  .feature-image-wrapper {
    display: flex;
    justify-content: center;
  }

  .feature-image {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(110, 92, 74, 0.10);
  }

  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .feature-text {
    max-width: 480px;
  }

  .feature-name {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-4xl));
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
    line-height: 1.05;
  }

  .feature-tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--font-size-xl);
    color: var(--color-clay);
    margin: 0 0 var(--space-md);
    line-height: 1.4;
  }

  .feature-body {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ─── Bottom CTA ─── */
  .bottom-cta {
    padding: var(--space-2xl) 0;
    text-align: center;
    background-color: var(--color-paper-deep);
  }

  .bottom-cta-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(var(--font-size-xl), 2.6vw, var(--font-size-2xl));
    line-height: 1.4;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .bottom-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper);
    background-color: var(--color-moss);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: background-color var(--transition), transform var(--transition);
  }

  .bottom-cta-link:hover {
    background-color: var(--color-moss-soft);
    color: var(--color-paper);
    transform: translateY(-1px);
  }

  .bottom-cta-arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .bottom-cta-link:hover .bottom-cta-arrow {
    transform: translateX(4px);
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .features {
      padding: var(--space-xl) 0;
    }

    .feature {
      padding: var(--space-lg) 0;
    }

    .feature-grid,
    .feature--reversed .feature-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      direction: ltr;
    }

    .feature-image {
      max-width: 360px;
    }

    .feature-text {
      max-width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .bottom-cta {
      padding: var(--space-xl) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bottom-cta-link,
    .bottom-cta-arrow {
      transition: none;
    }

    .bottom-cta-link:hover {
      transform: none;
    }

    .bottom-cta-link:hover .bottom-cta-arrow {
      transform: none;
    }
  }
</style>
