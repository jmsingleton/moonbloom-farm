---
import MoonbloomMark from './MoonbloomMark.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <MoonbloomMark size={44} />
      <p class="footer-wordmark display">moonbloom farm</p>
      <p class="footer-line">grown with love in the valley of the moon.</p>
    </div>

    <ul class="footer-links">
      <li>
        <a href="https://www.instagram.com/moonbloomfarm" target="_blank" rel="noopener noreferrer" class="footer-link">
          instagram
        </a>
      </li>
      <li>
        <a href="mailto:hello@moonbloom.farm" class="footer-link">hello@moonbloom.farm</a>
      </li>
      <li>
        <a href="/visit" class="footer-link">visit the stand</a>
      </li>
    </ul>

    <p class="footer-copyright">© {currentYear} moonbloom farm · glen ellen, california</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }

  .footer-inner {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  /* reset.css makes svg display:block — center the mark within the brand block */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-wordmark {
    font-size: var(--text-xl);
    margin-top: var(--space-xs);
  }

  .footer-line {
    font-weight: 500;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  .footer-link {
    color: var(--paper);
    font-weight: 700;
    text-transform: lowercase;
    border-bottom: 2px solid var(--paper);
    padding-bottom: 0.1em;
  }

  .footer-link:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .footer-copyright {
    font-size: var(--text-sm);
    opacity: 0.8;
  }
</style>
