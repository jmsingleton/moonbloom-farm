---
---

<section class="about-preview" aria-label="About Moonbloom Farm">
  <div class="about-preview-inner container">
    <div class="about-preview-grid">
      <!-- Photo placeholder -->
      <div class="about-photo-wrapper">
        <div class="about-photo-placeholder">
          <img src="/images/about-farm.svg" alt="Moonbloom Farm" class="about-photo-img" loading="lazy" />
        </div>
      </div>

      <!-- Text content -->
      <div class="about-text">
        <h2 class="about-heading">Our Story</h2>
        <p class="about-description">
          A small farm and roadside stand on Arnold Drive in Glen Ellen. Eggs from our flock, produce from the garden, and baked goods from the kitchen — what we have, when we have it.
        </p>
        <a href="/about" class="about-link">
          Learn More <span class="about-link-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Section ─── */
  .about-preview {
    padding: var(--space-2xl) 0;
  }

  /* ─── Grid Layout ─── */
  .about-preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  /* ─── Photo Placeholder ─── */
  .about-photo-wrapper {
    display: flex;
    justify-content: center;
  }

  .about-photo-placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 5;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 24px rgba(110, 92, 74, 0.10);
    overflow: hidden;
  }

  .about-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Text Content ─── */
  .about-text {
    max-width: 520px;
  }

  .about-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-3xl));
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-md);
  }

  .about-description {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-lg);
  }

  /* ─── Learn More Link ─── */
  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-moss);
    text-decoration: none;
    transition: color var(--transition);
  }

  .about-link:hover {
    color: var(--color-clay);
  }

  .about-link-arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .about-link:hover .about-link-arrow {
    transform: translateX(4px);
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .about-preview {
      padding: var(--space-xl) 0;
    }

    .about-preview-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      text-align: center;
    }

    .about-photo-placeholder {
      max-width: 320px;
    }

    .about-text {
      max-width: 100%;
    }

    .about-link {
      justify-content: center;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .about-link,
    .about-link-arrow {
      transition: none;
    }
  }
</style>
