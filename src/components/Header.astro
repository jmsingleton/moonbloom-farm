---
import MoonbloomMark from './MoonbloomMark.astro';

const navLinks = [
  { href: '/about', label: 'about' },
  { href: '/blog', label: 'journal' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="brand" aria-label="moonbloom farm home">
      <MoonbloomMark size={30} />
      <span class="brand-name display">moonbloom farm</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        <li>
          <a href="/visit" class="btn">visit the stand →</a>
        </li>
      </ul>
    </nav>

    <button
      class="hamburger"
      id="hamburger-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    <ul class="mobile-nav-list">
      <li><a href="/" class="mobile-nav-link display">home</a></li>
      {navLinks.map((link) => (
        <li><a href={link.href} class="mobile-nav-link display">{link.label}</a></li>
      ))}
      <li class="mobile-nav-cta"><a href="/visit" class="btn">visit the stand →</a></li>
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }

  .brand-name {
    font-size: 1.25rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .nav-link {
    font-weight: 700;
    text-transform: lowercase;
    padding-bottom: 0.15em;
    border-bottom: 3px solid transparent;
  }

  .nav-link:hover,
  .nav-link.active {
    border-bottom-color: var(--ink);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px;
    height: 44px;
    padding: 9px;
    background: transparent;
    border: 2px solid var(--ink);
    cursor: pointer;
    z-index: 110;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--ink);
    transition: transform 150ms ease;
  }

  .hamburger.open .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .hamburger.open .hamburger-line:nth-child(2) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 105;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  .mobile-nav.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .mobile-nav-link {
    font-size: clamp(2rem, 9vw, 2.8rem);
  }

  .mobile-nav-link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .mobile-nav-cta {
    margin-top: var(--space-sm);
  }

  @media (max-width: 760px) {
    .desktop-nav { display: none; }
    .hamburger { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav, .hamburger-line { transition: none; }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileNav = document.getElementById('mobile-nav');

  if (hamburgerBtn && mobileNav) {
    const openMenu = () => {
      hamburgerBtn.classList.add('open');
      mobileNav.classList.add('open');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      mobileNav.setAttribute('aria-hidden', 'false');
      hamburgerBtn.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      hamburgerBtn.classList.remove('open');
      mobileNav.classList.remove('open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      mobileNav.setAttribute('aria-hidden', 'true');
      hamburgerBtn.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
    };

    hamburgerBtn.addEventListener('click', () => {
      hamburgerBtn.classList.contains('open') ? closeMenu() : openMenu();
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburgerBtn.classList.contains('open')) {
        closeMenu();
        hamburgerBtn.focus();
      }
    });
  }
</script>
