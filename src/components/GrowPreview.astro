---
const categories = [
  {
    name: 'Eggs',
    description: 'Pasture-raised, when the girls are laying.',
    image: '/images/placeholder-eggs.svg',
  },
  {
    name: 'Produce',
    description: 'Whatever the garden is offering this week.',
    image: '/images/placeholder-produce.svg',
  },
  {
    name: 'Baked Goods',
    description: 'From the farmhouse kitchen, when the oven is on.',
    image: '/images/placeholder-baked-goods.svg',
  },
];
---

<section class="grow-preview" aria-label="What We Grow">
  <div class="grow-preview-inner container">
    <h2 class="grow-heading">At the Stand</h2>
    <p class="grow-subheading">Three things, made small, sold honestly.</p>

    <div class="grow-grid">
      {categories.map((cat) => (
        <div class="grow-card">
          <div class="grow-card-image">
            <img src={cat.image} alt={cat.name} class="grow-card-img" loading="lazy" />
          </div>
          <h3 class="grow-card-name">{cat.name}</h3>
          <p class="grow-card-desc">{cat.description}</p>
        </div>
      ))}
    </div>

    <div class="grow-cta">
      <a href="/what-we-sell" class="grow-link">
        See Everything <span class="grow-link-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── Section ─── */
  .grow-preview {
    background-color: var(--color-paper-deep);
    padding: var(--space-2xl) 0;
  }

  /* ─── Heading ─── */
  .grow-heading {
    font-family: var(--font-heading);
    font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-3xl));
    font-weight: 600;
    color: var(--color-ink);
    text-align: center;
    margin: 0 0 var(--space-xs);
  }

  .grow-subheading {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--font-size-lg);
    color: var(--color-clay);
    text-align: center;
    margin: 0 0 var(--space-xl);
  }

  /* ─── Card Grid ─── */
  .grow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* ─── Card ─── */
  .grow-card {
    text-align: center;
  }

  .grow-card-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--border-radius);
    overflow: hidden;
    margin-bottom: var(--space-md);
    box-shadow: 0 2px 12px rgba(110, 92, 74, 0.08);
  }

  .grow-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .grow-card-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs);
  }

  .grow-card-desc {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }

  /* ─── CTA Link ─── */
  .grow-cta {
    text-align: center;
    margin-top: var(--space-xl);
  }

  .grow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-moss);
    text-decoration: none;
    transition: color var(--transition);
  }

  .grow-link:hover {
    color: var(--color-clay);
  }

  .grow-link-arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  .grow-link:hover .grow-link-arrow {
    transform: translateX(4px);
  }

  /* ─── Responsive: Mobile ─── */
  @media (max-width: 600px) {
    .grow-preview {
      padding: var(--space-xl) 0;
    }

    .grow-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .grow-link,
    .grow-link-arrow {
      transition: none;
    }
  }
</style>
