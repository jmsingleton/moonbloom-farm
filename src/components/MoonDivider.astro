---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['moon-divider', className]} role="separator" aria-hidden="true">
  <svg width="160" height="16" viewBox="0 0 160 16" fill="currentColor">
    <circle cx="8" cy="8" r="7" />
    <g>
      <circle cx="44" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M44 1 A 7 7 0 0 0 44 15 Z" />
    </g>
    <circle cx="80" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2" />
    <g>
      <circle cx="116" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="2" />
      <path d="M116 1 A 7 7 0 0 1 116 15 Z" />
    </g>
    <circle cx="152" cy="8" r="7" />
  </svg>
</div>

<style>
  .moon-divider {
    display: flex;
    justify-content: center;
    padding: var(--space-lg) 0;
    color: var(--ink);
  }
</style>
