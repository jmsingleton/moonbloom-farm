---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Crescent moon, opening to the right -->
  <path d="M21 5.5 C 13 5.5, 7 11, 7 17.5 C 7 24, 13 28.5, 20 28.5 C 16 26, 13 22, 13 17.5 C 13 13, 16.5 8.5, 21 5.5 Z" />
  <!-- Small sprig curling from below the moon -->
  <path d="M14.5 31 Q 17 28.5, 22 28.5" />
  <path d="M18 30 Q 18.4 29.4, 19.2 29.2" />
</svg>
